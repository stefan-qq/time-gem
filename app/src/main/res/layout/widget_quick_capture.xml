<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="8dp" android:gravity="center">
  <ImageView android:id="@+id/widget_mascot" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_time_gem_logo" android:contentDescription="Open Time Gem" />
  <ImageButton android:id="@+id/widget_new" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="48dp" android:minHeight="48dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_add" android:contentDescription="New note" android:background="?android:attr/selectableItemBackgroundBorderless" />
<ImageButton android:id="@+id/widget_image" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="48dp" android:minHeight="48dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_image" android:contentDescription="Add image" android:background="?android:attr/selectableItemBackgroundBorderless" />
<ImageButton android:id="@+id/widget_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="48dp" android:minHeight="48dp" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_mic" android:contentDescription="Add audio" android:background="?android:attr/selectableItemBackgroundBorderless" />

 </LinearLayout>
</FrameLayout>